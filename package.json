{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "This repository is the solution of nodejs-assignments https://github.com/AlreadyBored/nodejs-assignments/blob/main/assignments/crud-api/score.md",
  "main": "app.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start:dev": "nodemon src/app.ts",
    "start:prod": "npm run build && node dist/app.js",
    "start:multi": "npm run build && node dist/loadBalancer.js",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenitfan19/node-crud-api.git"
  },
  "keywords": [
    "nodejs",
    "crud"
  ],
  "author": "Andrey Lavrov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zenitfan19/node-crud-api/issues"
  },
  "homepage": "https://github.com/zenitfan19/node-crud-api#readme",
  "dependencies": {
    "dotenv": "^16.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
